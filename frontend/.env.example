# Contract addresses per network. Optional -- the app works immediately
# after clone with no setup at all, since src/config/chains.ts falls back
# to the real deployed addresses below if these are unset. These are
# public contract addresses, not secrets -- safe to set directly as
# Vercel project environment variables without a committed .env file, if
# you redeploy the contract and want to point the app at a new address
# without editing chains.ts.
VITE_CONTRACT_ADDRESS_STUDIONET=0xA572D90194e5937caD8b0dE03A8D245784E5ADd5
VITE_CONTRACT_ADDRESS_BRADBURY=0xa010508a7A294De55B5C89999b9d6347bd0B4688
